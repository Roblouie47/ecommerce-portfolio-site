# Local development only. Copy to .env and fill real values.
# Production secrets must be configured in Render's Environment Variables UI.

PORT=3000
PUBLIC_URL=http://localhost:3000

ADMIN_TOKEN=changeme
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Shop Admin
ADMIN_ALLOWED_IPS=

SESSION_SECRET=dev-session-secret
JWT_SECRET=dev-jwt-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_PASS=super-secret
EMAIL_FROM=shop@example.com
EMAIL_DEV_MODE=false

STRIPE_SECRET=sk_test_xxx
STRIPE_PUBLISHABLE=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
