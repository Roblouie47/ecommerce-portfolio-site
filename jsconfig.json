{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "strict": false
    },
    "include": [
        "src/**/*",
        "public/js/**/*"
    ],
    "exclude": [
        "node_modules",
        "server.err",
        "data/**/*"
    ]
}
